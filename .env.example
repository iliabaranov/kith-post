# Kith Post — secrets & per-environment values. Copy to .env (git-ignored).
# All app env vars are prefixed KITH_. Env overrides config.toml.
# See docs/deploy.md for the full home-server + Cloudflare Tunnel walkthrough.

# --- Secrets (generate real values; do NOT reuse the examples) ---

# Session cookie signing key. Generate your own — a shared one means anyone with
# this file can forge a signed-in session. The app refuses to start on an https
# base_url while this is still the built-in default.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# KITH_SECRET_KEY=

# Fernet key for encrypting PII at rest. REQUIRED in production — without it the
# app makes a throwaway dev key under the data dir. BACK THIS UP: lose it and the
# stored emails/tokens become undecryptable. To migrate existing data to a new
# box, copy the data volume AND reuse this key.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KITH_FERNET_KEY=

# --- Per-environment ---

# Public origin. Local: http://localhost:8000. Server: your https URL, e.g.
# https://example.com — this is what the OAuth redirect and every emailed
# invitation link are built from, so it MUST be the URL guests can actually open.
# KITH_BASE_URL=http://localhost:8000

# dry-run (writes .eml to <data>/outbox) | self-only (real send, only to you) |
# live (real send to recipients). Start at self-only on the server, then live.
# KITH_SEND_MODE=dry-run

# --- Google OAuth (from Google Cloud Console, G1) ---
# Add every origin's callback to the client's Authorized redirect URIs:
#   http://localhost:8000/auth/callback  and  https://example.com/auth/callback
# KITH_GOOGLE_CLIENT_ID=
# KITH_GOOGLE_CLIENT_SECRET=

# --- Access control (invite-only) ---
# Address shown to people rejected at sign-in, so they know who to ask for access.
# KITH_CONTACT_EMAIL=you@example.com
# Optional in-app whitelist (comma/space separated). Empty = rely on Google's
# OAuth test-user list. If you set it, INCLUDE your own Google address or you'll
# lock yourself out. Enforced after Google auth, so it also works if the app is
# ever set to "In production (unverified)" where anyone can authenticate.
# KITH_ALLOWED_EMAILS=you@gmail.com, friend@example.com

# --- Cloudflare Tunnel (public HTTPS, docker compose --profile public) ---
# Token from Zero Trust > Networks > Tunnels; the tunnel's public hostname routes
# your domain to http://kith:8000. Not needed for local runs.
# CLOUDFLARE_TUNNEL_TOKEN=

# --- WhatsApp channel (docker compose --profile whatsapp) ---
# Invites and reminders can also go out over WhatsApp, sent from each host's own
# linked account by a self-hosted WAHA container (http://waha:3000 on the compose
# network — it is never published to the LAN or the tunnel).
#
# WAHA is an UNOFFICIAL WhatsApp client. It violates WhatsApp's terms of service
# and a linked account can be restricted or banned. At personal-invite volume to
# people who already know you the practical risk is low, but it is real, and the
# app warns every host before they link. Enable this only if you accept that.
#
# Off unless you set both of these:
# KITH_WHATSAPP_ENABLED=true
# KITH_WAHA_API_KEY=<a long random string; also read by the waha container>
#
# Where the app reaches WAHA. The compose default is right for the normal stack.
# KITH_WAHA_URL=http://waha:3000
# Seconds before a WAHA call is abandoned. Do not raise this much: an unpaired
# session makes WAHA hang rather than fail, and this bound is what stops one
# wedged session from tying up a request handler or the reminder sweep.
# KITH_WAHA_TIMEOUT_SECONDS=20
# Pause between consecutive WhatsApp sends, picked at random from this range for
# each message. Blasting contacts is what earns an account a reachout timelock
# (error 463), and a metronome-steady gap is its own tell that a machine is
# typing. Because of this, a WhatsApp batch is sent AFTER the page responds — a
# dozen invitations takes a few minutes, and recipients show as sent as it works
# through them. Set both to 0 only for testing.
# KITH_WAHA_SEND_GAP_MIN_SECONDS=5
# KITH_WAHA_SEND_GAP_MAX_SECONDS=20
#
# Set these even though compose disables the dashboard and Swagger: WAHA invents
# its own credentials and PRINTS THEM TO ITS LOG whenever they're unset, whether
# or not the UI is enabled. Also used by docker-compose.dashboard.yml if you ever
# bring the admin UI up on localhost.
# WAHA_DASHBOARD_USERNAME=admin
# WAHA_DASHBOARD_PASSWORD=<a long random string>
# Delivery + read receipts. WAHA POSTs them back to the app, signed with this
# secret (HMAC-SHA512 of the body). Leave the secret empty to turn receipts off:
# no webhook is configured on the session and the endpoint refuses everything.
# The URL is the compose-network address on purpose — a public one would leave
# the box and come back through the tunnel for nothing.
# KITH_WAHA_WEBHOOK_SECRET=<a long random string>
# KITH_WAHA_WEBHOOK_URL=http://kith:8000/wa/webhook

# ---------------------------------------------------------------------------
# SMS channel (optional, off by default)
# ---------------------------------------------------------------------------
# A third channel alongside email and WhatsApp: a plain text message carrying
# the same per-recipient invitation link. Text only — no card picture, since a
# text cannot carry one; the card lives on the page the link opens.
#
# Unlike WhatsApp, this is configured ONCE for the whole instance rather than
# linked per host. There is no setup page: the compose box appears when the
# operator has configured a provider here, and not otherwise.
#
# You must have consent to text the people you are texting, the same as the
# terms already say for email. A STOP reply opts a number out permanently.
# KITH_SMS_ENABLED=true
# KITH_SMS_PROVIDER=twilio          # "none" | "twilio" | "gateway"
#
# Seconds before a provider call is abandoned.
# KITH_SMS_TIMEOUT_SECONDS=20
# Pause between consecutive texts, drawn fresh at random from this range.
# Shorter than WhatsApp's: a carrier throttles or spam-filters a burst rather
# than banning the number, but a hundred texts fired flat out still get filtered.
# KITH_SMS_SEND_GAP_MIN_SECONDS=1
# KITH_SMS_SEND_GAP_MAX_SECONDS=4
#
# Your own number, for a self-only test send — any readable form, normalised to
# E.164. With this unset a self-only send holds every text, with the recipients
# still queued and the card saying why; it never falls through to the guest.
# KITH_SMS_SELF_NUMBER=+15551234567

# --- Twilio (KITH_SMS_PROVIDER=twilio) ---
# The reliable option: a real carrier relationship and receipts that mean
# something. Per-message cost is pennies; what actually costs money at a party's
# scale is the monthly number rental and the A2P 10DLC campaign registration.
# KITH_SMS_TWILIO_ACCOUNT_SID=<the AC... SID from the Twilio console>
# KITH_SMS_TWILIO_AUTH_TOKEN=<the auth token from the Twilio console>
# The sender: either a Twilio number you own, in E.164...
# KITH_SMS_TWILIO_FROM=+15551234567
# ...or a Messaging Service, which picks the number itself. If both are set the
# Messaging Service wins.
# KITH_SMS_TWILIO_MESSAGING_SERVICE_SID=<the MG... SID>

# --- Android SMS gateway (KITH_SMS_PROVIDER=gateway) ---
# The recommended option for occasional, small lists: the capcom6 "SMS Gateway
# for Android" app sends from a SIM you already own. No per-message fee, no
# number to rent, no A2P registration. What it costs instead is a phone kept
# powered and on the same network as the box — and the same caveat WhatsApp
# carries: a consumer number sending a hundred texts in an evening is what
# carriers throttle and filter. Keep lists small.
#
# Install the app, turn on its Local Server, and read the URL and credentials
# off the app's Local Server section. The URL is the base only — no path; the
# path is its own setting below, and a URL that already ends in /message would
# send to /message/message.
# KITH_SMS_GATEWAY_URL=http://192.168.1.50:8080
# KITH_SMS_GATEWAY_USER=<the username the app shows>
# KITH_SMS_GATEWAY_PASS=<the password the app shows>
#
# The send path differs by deployment shape. The default, /message, is the
# app's on-device Local Server; set /3rdparty/v1/messages if you run the
# project's server component instead (for a phone that isn't directly
# reachable from the container). One line — two uncommented lines would mean
# the second quietly wins.
# KITH_SMS_GATEWAY_PATH=/message
#
# Only needed when a relay fronts more than one phone.
# KITH_SMS_GATEWAY_DEVICE_ID=<the device id from the relay>
#
# Never expose the gateway through the public tunnel. Not being reachable from
# the internet is the whole of its security model.

# --- SMS delivery receipts and STOP replies (both providers) ---
# Off until this secret is set: with it empty both webhook endpoints 404 and
# nothing is recorded — which means NO STOP REPLY REACHES THIS APP. Set it as
# part of setting the channel up, not as an extra. Setting it turns on the one
# endpoint for the provider you configured; the other stays a 404.
#
# The two providers sign differently, so they have separate endpoints and you
# only need to configure the one you use:
#
#   Twilio   -> POST <base_url>/sms/webhook/twilio
#               Signed with your Twilio auth token (X-Twilio-Signature), not
#               with the secret below. Registered automatically as the
#               StatusCallback on every send once this secret is set. It must be
#               PUBLICLY reachable — the call comes from Twilio's servers — so
#               it uses base_url, unlike the WhatsApp webhook above which is
#               compose-internal. Point Twilio's inbound-message webhook at the
#               same URL to receive STOP replies.
#
#   Gateway  -> POST <reachable-url>/sms/webhook/gateway
#               Signed with the secret below (HMAC-SHA256 of body + timestamp).
#               Set the SAME value as the app's Settings -> Webhooks -> Signing
#               Key, then register the webhook in the app for the sms:received,
#               sms:delivered, sms:failed and sms:cancelled events. Signed POSTs
#               older than five minutes are refused, so the phone's clock needs
#               to be roughly right.
# KITH_SMS_WEBHOOK_SECRET=<a long random string>
#
# Once the webhook is on, a STOP, STOPALL, UNSUBSCRIBE, CANCEL, END or QUIT
# reply opts that number out permanently, across every card anyone on this site
# ever sends; START or UNSTOP undoes it. The record is kept as a hash of the
# number in its own table — it outlives the card, the contact and the account.
