# Kith Invite — secrets & per-environment values. Copy to .env (git-ignored).
# Anything here overrides config.toml. All app env vars are prefixed KITH_.

# Session cookie signing key — generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KITH_SECRET_KEY=dev-insecure-change-me

# Fernet key for encrypting PII at rest (used from G1 onward):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KITH_FERNET_KEY=

# Override config.toml if you like:
# KITH_BASE_URL=http://localhost:8000
# KITH_SEND_MODE=dry-run

# Google OAuth (added in G1):
# KITH_GOOGLE_CLIENT_ID=
# KITH_GOOGLE_CLIENT_SECRET=
